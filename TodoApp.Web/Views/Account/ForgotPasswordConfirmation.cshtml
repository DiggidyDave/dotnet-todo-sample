@{
    ViewData["Title"] = "Check Your Email";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4 text-center">
                <div class="mb-4">
                    <i class="bi bi-envelope-check text-success" style="font-size: 4rem;"></i>
                </div>
                <h2 class="card-title mb-3">Check Your Email</h2>
                <p class="text-muted mb-4">
                    If an account exists with that email address, we've sent a password reset link.
                    Please check your inbox and follow the instructions.
                </p>
                <a asp-action="Login" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Back to Login
                </a>
            </div>
        </div>
    </div>
</div>
