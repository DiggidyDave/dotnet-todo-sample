@model TaskListViewModel
@{
    ViewData["Title"] = "My Tasks";
}

<div class="row">
    <!-- Create Task Form -->
    <div class="col-lg-4 mb-4">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-plus-circle me-2"></i>Add New Task
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label asp-for="CreateTask.Title" class="form-label">Title</label>
                        <input asp-for="CreateTask.Title" class="form-control" placeholder="What needs to be done?" />
                        <span asp-validation-for="CreateTask.Title" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CreateTask.Description" class="form-label">Description (optional)</label>
                        <textarea asp-for="CreateTask.Description" class="form-control" rows="3" placeholder="Add more details..."></textarea>
                        <span asp-validation-for="CreateTask.Description" class="text-danger"></span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-lg me-2"></i>Add Task
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Task Stats -->
        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-4">
                        <div class="fs-4 fw-bold text-primary">@Model.TotalCount</div>
                        <small class="text-muted">Total</small>
                    </div>
                    <div class="col-4">
                        <div class="fs-4 fw-bold text-warning">@Model.ActiveCount</div>
                        <small class="text-muted">Active</small>
                    </div>
                    <div class="col-4">
                        <div class="fs-4 fw-bold text-success">@Model.CompletedCount</div>
                        <small class="text-muted">Done</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Task List -->
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <ul class="nav nav-tabs card-header-tabs">
                    <li class="nav-item">
                        <a class="nav-link @(Model.Filter == "all" ? "active" : "")"
                           asp-action="Index" asp-route-filter="all">
                            All <span class="badge bg-secondary">@Model.TotalCount</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.Filter == "active" ? "active" : "")"
                           asp-action="Index" asp-route-filter="active">
                            Active <span class="badge bg-warning text-dark">@Model.ActiveCount</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(Model.Filter == "completed" ? "active" : "")"
                           asp-action="Index" asp-route-filter="completed">
                            Completed <span class="badge bg-success">@Model.CompletedCount</span>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="card-body p-0">
                @if (Model.Tasks.Any())
                {
                    <div class="list-group list-group-flush" id="task-list">
                        @foreach (var task in Model.Tasks)
                        {
                            <partial name="_TaskItem" model="task" />
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-3">
                            @if (Model.Filter == "completed")
                            {
                                <span>No completed tasks yet. Keep working!</span>
                            }
                            else if (Model.Filter == "active")
                            {
                                <span>All tasks completed. Great job!</span>
                            }
                            else
                            {
                                <span>No tasks yet. Add one to get started!</span>
                            }
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/task.js" asp-append-version="true"></script>
}
